#!/usr/bin/env python3
import os
import sys
from pathlib import Path

python = os.environ.get("NEBULA_PYTHON")
if not python:
    venv = os.environ.get("NEBULA_VENV")
    if venv and os.access(Path(venv) / "bin/python", os.X_OK):
        python = str(Path(venv) / "bin/python")
    else:
        state = Path(os.environ.get("XDG_STATE_HOME") or Path.home() / ".local/state")
        candidate = state / "quickshell/.venv/bin/python"
        if os.access(candidate, os.X_OK):
            python = str(candidate)
if python and os.path.abspath(python) != os.path.abspath(sys.executable):
    os.execvp(python, [python, *sys.argv])

root = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(root / "cli"))

from nebula.cli import main

if __name__ == "__main__":
    main()
